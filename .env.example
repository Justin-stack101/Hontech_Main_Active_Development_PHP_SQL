# ============================================================
# HonTech AutoCenter — Environment Configuration Template
# Copy this file to .env and configure for your local/prod server.
# WARNING: NEVER commit the actual .env file to GitHub!
# ============================================================

APP_ENV=development
PORT=8000

# Database Configuration (MySQL / MariaDB via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hontech
DB_USER=root
DB_PASS=

# JWT & Security Tokens
JWT_SECRET=your_secure_random_jwt_secret_key_here_min_32_chars

# Google Cloud OAuth API (Leave blank for Mock Development Mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# SMTP Mail Server (For Password Reset / Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@hontech-autocenter.com

# Default Seed Passwords (For Local Testing Only)
OWNER_PASSWORD=owner123
ADMIN_PASSWORD=admin123
STAFF_PASSWORD=staff123
SA_PASSWORD=sa123
TECH_PASSWORD=tech123
