RewriteEngine On

# =============================================
# API Routing — Forward /api/* to PHP backend
# =============================================
RewriteRule ^api/(.*)$ backend/index.php [QSA,L]

# =============================================
# Static Frontend Assets — Serve directly
# =============================================
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# =============================================
# SPA Fallback — Serve frontend/index.html
# =============================================
RewriteRule ^frontend/.*$ frontend/index.html [L]

# =============================================
# REV-198: HTML pages are re-checked on every load (ETag makes it cheap), so an open
# browser or TV never keeps running an old copy of index.html / tv.html after an update.
# Scripts keep their ?v= cache busters.
# =============================================
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
