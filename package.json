{
  "name": "hontech-ops-system",
  "version": "1.0.0",
  "description": "HonTech AutoCenter Operations System (PHP PDO + MySQL Backend, Vanilla JS SPA Frontend)",
  "type": "module",
  "scripts": {
    "dev": "php -S 0.0.0.0:8000 router.php",
    "start": "php -S 0.0.0.0:8000 router.php",
    "tunnel": "node scripts/tunnel.js",
    "build:sass": "sass frontend/scss/main.scss frontend/css/main.css",
    "watch:sass": "sass --watch frontend/scss/main.scss frontend/css/main.css",
    "test:frontend": "node --test tests/frontend/*.test.js",
    "test:backend": "node --test tests/backend/*.test.js",
    "test:security": "node --test tests/security/*.test.js",
    "test": "node --test tests/frontend/*.test.js tests/backend/*.test.js tests/security/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "localtunnel": "^2.0.2"
  },
  "devDependencies": {
    "sass": "^1.75.0"
  }
}
